  "narrative": {
    "northStar": "The Community Noticeboard",
    "overview": "The site is the board outside a community kitchen: things pinned, taped and stuck to it by a real person. Name tags, taped polaroids, pushpin cards, round stickers and a flyer with tear-off strips carry the content. The objects are physical and slightly crooked; the type is loud, chunky and tight; the palette is soft pastel on a warm plum ink. It should feel hand-assembled and friendly, never corporate and never loud in colour.",
    "keyCharacteristics": [
      "Pastel pink and butter yellow on blush, with deep plum ink and plum \"night\" sections.",
      "Chunky, tightly tracked Bricolage Grotesque display type, with italic Instrument Serif for the emotional word.",
      "Real-world noticeboard objects: tape, pushpins, polaroids, stickers, name tags, a tear-off flyer.",
      "Small tilts and one shared soft plum shadow on anything \"pinned\".",
      "Pill-shaped buttons, chips and tags."
    ],
    "rules": [
      {
        "name": "The No-Neon Rule",
        "body": "Brit hates neon. Every colour stays pastel or deep plum; no saturated electric hues, no glows, no gradients beyond the pink-to-butter podcast cover.",
        "section": "colors"
      },
      {
        "name": "The Raspberry-for-Text Rule",
        "body": "Pink text on a light background is always pink-deep. pink is a fill, or text on night.",
        "section": "colors"
      },
      {
        "name": "The One Tender Word Rule",
        "body": "Instrument Serif italic marks a single emphasised word or short phrase inside a display line, in Raspberry Ink (or Bubblegum on night). Never a whole headline, never body copy.",
        "section": "typography"
      },
      {
        "name": "The Marker-Is-Handwriting Rule",
        "body": "Permanent Marker appears only where a person would have written by hand on the board: captions, notes, the name tag. Never for headings, buttons or paragraphs.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use pink-deep for any pink text on blush, paper or butter.",
      "Do make new content look like something pinned to the board (paper, tape, pin, sticker, marker note) when it's a standalone object.",
      "Do keep every button, chip and tag a pill.",
      "Do give every animation a prefers-reduced-motion fallback that leaves content visible and still.",
      "Do keep the focus ring: 2px pink-deep on light, pink on night, 3px offset."
    ],
    "donts": [
      "Don't use neon, electric or fully saturated colours, or glows.",
      "Don't use pink as text on a light background.",
      "Don't set headlines or body copy in Permanent Marker or Instrument Serif.",
      "Don't add a new shadow when the shared pinned shadow fits.",
      "Don't add forms; contact stays as links (see PRODUCT.md)."
    ]
  }
}